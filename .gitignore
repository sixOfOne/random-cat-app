cat > .gitignore << 'EOF'
# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Docker
*.dockerignore
.docker/

# Mac OS
.DS_Store
.AppleDouble
.LSOverride

# Logs
*.log
logs/

# IDEs
.vscode/
.idea/
*.swp
*.swo
EOF
